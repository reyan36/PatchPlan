# Copy to .env.local and fill in. Never commit real keys.

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Status page
UPTIMEROBOT_API_KEY=

# ── PatchPlan AI (server-only, never prefix with NEXT_PUBLIC_) ──

# Nebius Token Factory: runs all AI calls.
NEBIUS_API_KEY=
# Optional overrides. List the models your key can use with:
#   curl -H "Authorization: Bearer $NEBIUS_API_KEY" https://api.tokenfactory.nebius.com/v1/models
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_SMALL_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_LARGE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily: searches Steam, Reddit and the web for player feedback.
TAVILY_API_KEY=

# Discord bot: reads player messages from the feedback channel set in AI > Player Signal > Sources.
# The bot needs View Channel + Read Message History, and the Message Content intent enabled.
DISCORD_BOT_TOKEN=

# ── Email (server-only) ──

# Resend sends the emails. https://resend.com → API Keys.
RESEND_API_KEY=
# An address on a domain you verified in Resend (add its DNS records first).
EMAIL_FROM_ADDRESS=updates@mail.patchplan.net
# Firebase Admin, for public sign-ups, unsubscribes and scheduled digests.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=
# Your live site, used in email links and unsubscribe pages.
NEXT_PUBLIC_APP_URL=https://patchplan.net
# Random string; Vercel Cron sends it so only Vercel can trigger digests.
CRON_SECRET=

# ─── Admin ───
# Verified emails allowed to open /admin/maintenance and /admin/security (comma-separated).
# They also receive security alerts by email.
ADMIN_EMAILS=you@example.com

# ─── Security alerts (optional) ───
# Discord webhook for instant alerts on your phone (Server Settings → Integrations → Webhooks).
SECURITY_WEBHOOK_URL=
# Suspicious requests in 10 minutes that count as an attack (default 20).
SECURITY_BURST_THRESHOLD=
# ─── AI spending caps (all optional) ───
# Accounts allowed to use AI, comma-separated (default judges@patchplan.net). "*" opens it to everyone.
AI_ALLOWED_EMAILS=
# Pause every AI feature instantly (then redeploy): AI_DISABLED=true
AI_DISABLED=
# AI requests per account per day (default 40).
AI_DAILY_LIMIT=
# Nebius model calls across ALL accounts, per day / per month (defaults 150 / 2000).
AI_GLOBAL_DAILY_LIMIT=
AI_GLOBAL_MONTHLY_LIMIT=
# Tavily searches across all accounts per day / per month (defaults 30 / 300). One Player Signal collect = 3 searches.
TAVILY_DAILY_LIMIT=
TAVILY_MONTHLY_LIMIT=
# Player Signal web collects per account per day (default 5).
TAVILY_ACCOUNT_DAILY_LIMIT=
# "basic" (1 credit per search, default) or "advanced" (2 credits).
TAVILY_SEARCH_DEPTH=
